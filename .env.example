# Build-time settings read by the app (Vite exposes only VITE_* variables). None are secrets: the RevenueCat key is the
# public App Store key and is visible inside the app. Leave everything unset for a build with no purchases.

# RevenueCat public App Store key (starts with appl_). Required for any purchase feature on iOS.
VITE_REVENUECAT_IOS_KEY=

# 1 = show the daily paid pack offer. Needs VITE_REVENUECAT_IOS_KEY and a production bundle on native iOS.
VITE_DAILY_PACKS=0

# 1 = include the sandbox-only purchase diagnostic. Never submit such a build for release.
VITE_APPLE_SANDBOX_PURCHASE_TEST=0
